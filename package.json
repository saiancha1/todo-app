{
  "name": "todo-app",
  "version": "1.0.0",
  "private": true,
  "description": "Run the Todo API and Next.js frontend together for local development.",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "dotnet run --project backend/TodoApi --launch-profile http",
    "dev:web": "npm --prefix frontend run dev",
    "setup": "npm --prefix frontend install"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
